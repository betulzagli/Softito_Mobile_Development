PRAGMA foreign_keys=ON;

CREATE TABLE IF NOT EXISTS users(
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    full_name TEXT NOT NULL,
    email TEXT UNIQUE NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
)

// VERİ EKLEME

INSERT INTO users(full_name,email) values('Betül ZAĞLI',betulzagli@gmail.com)

//OKUMA

SELECT * FROM users WHERE id=1; //* idsi 1 olanın tüm bilgilerini getir. eğer hepsini istemiyorsak SELECT full_name yazarız mesela

//GÜNCELLEME

UPDATE users SET email=betulyeni@gmail.com WHERE id=1;

//SİLME

DELETE FROM users WHERE id=1;
